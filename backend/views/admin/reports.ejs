<div class="content-card">
    <h2>Reported Listings & Users</h2>
    
    <table id="reports-table">
        <thead>
            <tr>
                <th>Report ID</th>
                <th>Listing ID</th>
                <th>Title</th>
                <th>Reported User ID</th>
                <th>Username</th>
                <th>Report Count (Listing)</th>
                <th>Report Count (User)</th>
                <!-- <th>Actions</th> -->
            </tr>
        </thead>
        <tbody>
            <% reports.forEach(report => { %>
                <tr>
                    <td><%= report.ID %></td>
                    <td><%= report.listingId %></td>
                    <td><%= listings[report.listingId]?.title || 'N/A' %></td>
                    <td><%= report.reportedUserId %></td>
                    <td><%= users[report.reportedUserId]?.name || 'Unknown' %></td>
                    <td><%= listingReportCounts[report.listingId] || 0 %></td>
                    <td><%= userReportCounts[report.reportedUserId] || 0 %></td>
                    <!-- <td>
                        <a href="/admin/reports/dismiss/<%= report.id %>" class="btn btn-warning">Dismiss</a>
                        <a href="/admin/reports/remove-listing/<%= report.listingId %>" class="btn btn-danger">Remove Listing</a>
                    </td> -->
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

<script>
    document.querySelectorAll('.btn-warning').forEach(button => {
        button.addEventListener('click', function(event) {
            event.preventDefault();
            if (confirm('Are you sure you want to dismiss this report?')) {
                fetch(this.href, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => { alert(data.message); location.reload(); })
                    .catch(error => alert('Error: ' + error.message));
            }
        });
    });

    document.querySelectorAll('.btn-danger').forEach(button => {
        button.addEventListener('click', function(event) {
            event.preventDefault();
            if (confirm('Are you sure you want to remove this listing?')) {
                fetch(this.href, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => { alert(data.message); location.reload(); })
                    .catch(error => alert('Error: ' + error.message));
            }
        });
    });
</script>
