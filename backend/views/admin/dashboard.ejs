<style>
  body {
    display: none;
  }
</style>

<div id="main-content">
  <div class="content-card">
    <h2>Overview</h2>
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Total Users</h3>
        <p>
          <%= stats.totalUsers %>
        </p>
      </div>
      <div class="stat-card">
        <h3>Total Listings</h3>
        <p>
          <%= stats.totalListings %>
        </p>
      </div>
      <div class="stat-card">
        <h3>Active Listings</h3>
        <p>
          <%= stats.activeListings %>
        </p>
      </div>
    </div>
  </div>

  <div class="content-card">
    <h2>Quick Actions</h2>
    <div style="display: flex; gap: 10px;">
      <a href="/admin/users" class="btn">Manage Users</a>
      <a href="/admin/listings" class="btn">Manage Listings</a>
      <a href="/admin/categories" class="btn">Manage Categories</a>
      <a href="/admin/reports" class="btn">View Reports</a>
    </div>
  </div>
</div>

<script>
  window.onload = async () => {
    if (!sessionStorage.getItem("authToken")) {
      const username = prompt("Enter admin username:");
      const password = prompt("Enter admin password:");

      if (username && password) {
        try {
          const response = await fetch("/admin/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ username, password }),
          });

          if (response.ok) {
            const data = await response.json();
            sessionStorage.setItem("authToken", data.token);
            document.body.style.display = "block"; // show content after successful auth
          } else {
            alert("Login failed. Please refresh and try again.");
          }
        } catch (error) {
          console.error("Login error:", error);
          alert("Error during login. Please try again later.");
        }
      } else {
        alert("Username and password are required.");
      }
    } else {
      // Token already exists, show content
      document.body.style.display = "block";
    }
  };
</script>