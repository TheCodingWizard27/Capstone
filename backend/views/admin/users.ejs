<div class="content-card">
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <h2>Users List</h2>
      <button class="btn btn-success open-modal" data-modal="add-user-modal">Add New User</button>
    </div>
    
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Email</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.userName %></td>
            <td><%= user.email %></td>
            <td><%= user.createdAt.toLocaleDateString() %></td>
            <td>
              <!-- <a href="/admin/users/edit/<%= user.id %>" class="btn">Edit</a> -->
              <a href="/admin/users/delete/<%= user.id %>" class="btn btn-danger delete-btn">Delete</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  
  <!-- Add User Modal -->
  <div id="add-user-modal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Add New User</h2>
      <form action="/admin/users" method="POST">
        <div class="form-group">
          <label for="user_id">User ID</label>
          <input type="text" id="user_id" name="user_id" class="form-control" required>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success">Add User</button>
      </form>
    </div>
  </div>
  
  <script>
    $(document).ready(function() {
      // AJAX delete user
      $('.delete-btn').on('click', function(e) {
        e.preventDefault();
        
        if (confirm('Are you sure you want to delete this user?')) {
          const userId = $(this).attr('href').split('/').pop();
          
          $.ajax({
            url: `/admin/users/${userId}`,
            type: 'DELETE',
            success: function(result) {
              alert('User deleted successfully');
              location.reload();
            },
            error: function(err) {
              alert('Error deleting user: ' + err.responseJSON.message);
            }
          });
        }
      });
    });
  </script>